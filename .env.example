# AI providers (server-side only)
AI_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides for the tailoring step.
GEMINI_MODEL=
GROQ_MODEL=

# Optional model overrides for the pinned extraction step
EXTRACTION_MODEL=
EXTRACTION_FALLBACK_MODEL=

# Logging level for the server logs: debug, info, warn or error.
LOG_LEVEL=

# Public site URL, used for the metadata of the deployed app.
NEXT_PUBLIC_SITE_URL=

# Master Profile database (Supabase Postgres)
# DATABASE_URL is the runtime connection (transaction pooler, port 6543).
# DIRECT_URL is the direct connection used by migrations (port 5432).
DATABASE_URL=
DIRECT_URL=

# Auth.js
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Set to true when the app is not hosted on Vercel so Auth.js trusts the host header.
AUTH_TRUST_HOST=

# Key used to encrypt OAuth tokens at rest (64 hex characters or base64).
TOKEN_ENCRYPTION_KEY=

# Master Profile feature flag. Keep it false for the anonymous flow.
ENABLE_AUTH=
